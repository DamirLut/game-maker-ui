{
  "name": "game-maker-ui",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "build": "vite build && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "test": "vitest run --config vitest.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "!dist/styles.cjs",
    "!dist/styles.mjs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@laynezh/vite-plugin-lib-assets": "^2.1.3",
    "@storybook/react-vite": "10.3.6",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.6",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sass": "^1.99.0",
    "storybook": "10.3.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "^4.0.15",
    "vitest-browser-react": "^2.2.0"
  }
}
